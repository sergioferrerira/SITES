rules_version = '2';
// Regras de segurança das marcações do Camazo.
// Colar em: Consola Firebase → Firestore Database → Regras → Publicar.
// Quem gere: um documento admins/{uid} (criado à mão na consola, em Firestore → Dados).
// O uid de cada conta aparece no ecrã "Sem acesso" de gestao.html.
service cloud.firestore {
  match /databases/{db}/documents {

    function admin() {
      return request.auth != null
        && exists(/databases/$(db)/documents/admins/$(request.auth.uid));
    }

    // cada pessoa só consegue ver o seu próprio documento de administrador; ninguém o cria pelo site
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // meia hora n.º i da marcação: tem de ser deste dia e ficar ocupada no mesmo lote
    function slotOk(d, i) {
      return d.slots.size() <= i
        || (d.slots[i].matches(d.dia + '_[0-9]{4}')
            && existsAfter(/databases/$(db)/documents/ocupado/$(d.slots[i])));
    }

    function marcacaoValida() {
      let d = request.resource.data;
      return d.keys().hasOnly(['servId', 'servNome', 'min', 'preco', 'dia', 'hora', 'inicio', 'nome', 'tel', 'slots', 'criado'])
        && d.keys().hasAll(['servId', 'servNome', 'min', 'preco', 'dia', 'hora', 'inicio', 'nome', 'tel', 'slots', 'criado'])
        && d.servId is string && d.servId.size() <= 40
        && d.servNome is string && d.servNome.size() <= 120
        && d.min is int && d.min > 0 && d.min <= 240
        && d.preco is number
        && d.dia is string && d.dia.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && d.hora is string && d.hora.matches('[0-9]{2}:[0-9]{2}')
        && d.inicio is timestamp
        && d.inicio > request.time - duration.value(1, 'h')
        && d.inicio < request.time + duration.value(60, 'd')
        && d.nome is string && d.nome.size() >= 2 && d.nome.size() <= 60
        && d.tel is string && d.tel.size() >= 9 && d.tel.size() <= 20
        && d.criado == request.time
        && d.slots is list && d.slots.size() >= 1 && d.slots.size() <= 8
        && d.slots[0] == d.dia + '_' + d.hora.replace(':', '')
        && slotOk(d, 0) && slotOk(d, 1) && slotOk(d, 2) && slotOk(d, 3)
        && slotOk(d, 4) && slotOk(d, 5) && slotOk(d, 6) && slotOk(d, 7);
    }

    match /marcacoes/{id} {
      allow read, update, delete: if admin();
      allow create: if admin() || marcacaoValida();
    }

    match /ocupado/{slot} {
      // sem dados pessoais: o site precisa de saber que horas estão livres
      allow read: if true;
      // só pode ser ocupada junto com uma marcação que a inclua (ou pelo Camazo, para bloquear)
      allow create: if admin()
        || (request.resource.data.keys().hasOnly(['dia', 'marcacao'])
            && request.resource.data.marcacao is string
            && existsAfter(/databases/$(db)/documents/marcacoes/$(request.resource.data.marcacao))
            && slot in getAfter(/databases/$(db)/documents/marcacoes/$(request.resource.data.marcacao)).data.slots
            && request.resource.data.dia == getAfter(/databases/$(db)/documents/marcacoes/$(request.resource.data.marcacao)).data.dia);
      allow update: if false;
      allow delete: if admin();
    }
  }
}
